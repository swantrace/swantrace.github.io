{
  "name": "my-portfolio",
  "type": "module",
  "scripts": {
    "gen:posts": "bun run scripts/gen-posts.ts",
    "gen:posts:watch": "bun run scripts/gen-posts.ts --watch",
    "gen:sitemap": "bun run scripts/gen-sitemap.ts",
    "dev": "concurrently \"bun run gen:posts:watch\" \"vite\" --names \"posts,vite\" --prefix-colors \"blue,green\"",
    "build:local:client": "VITE_BASE=/ bun vite build --mode client",
    "build:local": "bun run gen:posts && bun run gen:sitemap && bun run build:local:client && VITE_BASE=/ bun vite build",
    "build:prod:client": "VITE_BASE=/ bun vite build --mode client",
    "build:prod": "bun run gen:posts && bun run gen:sitemap && bun run build:prod:client && VITE_BASE=/ bun vite build",
    "preview": "vite preview",
    "serve:local": "bun run build:local && bun run preview",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "dependencies": {
    "gray-matter": "^4.0.3",
    "haunted": "^6.1.0",
    "highlight.js": "^11.11.1",
    "hono": "^4.12.31",
    "honox": "^0.1.59",
    "katex": "^0.18.1",
    "lit-html": "^3.3.3",
    "markdown-it": "^14.3.0",
    "markdown-it-katex": "^2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@hono/vite-ssg": "^0.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.3.14",
    "@types/highlight.js": "^10.1.0",
    "@types/markdown-it": "^14.1.2",
    "chokidar": "^5.0.0",
    "concurrently": "^10.0.3",
    "daisyui": "^5.6.18",
    "fast-glob": "^3.3.3",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.1.5"
  }
}
