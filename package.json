{
  "name": "my-portfolio",
  "type": "module",
  "scripts": {
    "gen:posts": "bun run scripts/gen-posts.ts",
    "gen:posts:watch": "bun run scripts/gen-posts.ts --watch",
    "gen:sitemap": "bun run scripts/gen-sitemap.ts",
    "dev": "concurrently \"bun run gen:posts:watch\" \"vite\" --names \"posts,vite\" --prefix-colors \"blue,green\"",
    "build:local:client": "VITE_BASE=/ bun vite build --mode client",
    "build:local": "bun run gen:posts && bun run gen:sitemap && bun run build:local:client && VITE_BASE=/ bun vite build",
    "build:prod:client": "VITE_BASE=/ bun vite build --mode client",
    "build:prod": "bun run gen:posts && bun run gen:sitemap && bun run build:prod:client && VITE_BASE=/ bun vite build",
    "preview": "vite preview",
    "serve:local": "bun run build:local && bun run preview",
    "prepare": "husky",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "test": "bun test",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:all": "bun run test && bun run test:e2e",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md}": "biome format --write"
  },
  "dependencies": {
    "gray-matter": "^4.0.3",
    "haunted": "^6.1.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.14",
    "honox": "^0.1.62",
    "katex": "^0.19.1",
    "lit-html": "^3.3.3",
    "markdown-it": "^15.0.3",
    "markdown-it-katex": "^2.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@hono/vite-ssg": "^0.3.3",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/highlight.js": "^10.1.0",
    "@types/markdown-it": "^14.2.0",
    "chokidar": "^6.0.0",
    "concurrently": "^10.0.6",
    "daisyui": "^5.7.50",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "^8.3.5"
  }
}
